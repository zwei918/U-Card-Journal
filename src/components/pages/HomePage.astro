---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSiteCopy, normalizeLocale, localizedPath } from "@/i18n/site";

const locale = normalizeLocale(Astro.currentLocale);
const t = getSiteCopy(locale);

const latest = locale === "en"
  ? [
      { title: "A crypto card updates top-up fees and regional rules", meta: "Fees · 2 hours ago" },
      { title: "Apple Pay support update: which cards currently work", meta: "Payments · Today" },
      { title: "How to judge long-term card reliability as KYC gets stricter", meta: "Compliance · Yesterday" },
    ]
  : locale === "ja"
    ? [
        { title: "ある暗号資産カードが入金手数料と地域ルールを変更", meta: "手数料 · 2時間前" },
        { title: "Apple Pay 対応状況を更新：現在利用できるカード", meta: "決済 · 今日" },
        { title: "KYC 強化後に長期利用できるカードを見極める方法", meta: "コンプライアンス · 昨日" },
      ]
    : [
        { title: "某 U 卡调整充值费率，部分地区规则同步变化", meta: "费率 · 2 小时前" },
        { title: "Apple Pay 支持范围更新：这些卡片目前可绑定", meta: "支付 · 今天" },
        { title: "KYC 政策趋严后，如何判断一张 U 卡是否值得长期使用", meta: "合规 · 昨天" },
      ];

const cards = [
  { name: "Bybit Card", score: "4.6", note: locale === "en" ? "Daily spending / Apple Pay" : locale === "ja" ? "日常決済 / Apple Pay" : "适合日常消费与 Apple Pay 用户" },
  { name: "OKX Card", score: "4.4", note: locale === "en" ? "Multi-region / crypto users" : locale === "ja" ? "複数地域 / 暗号資産ユーザー" : "适合多地区与加密资产用户" },
  { name: "RedotPay", score: "4.3", note: locale === "en" ? "USDT payments / virtual card" : locale === "ja" ? "USDT 決済 / バーチャルカード" : "适合 USDT 支付与虚拟卡用户" },
];

const ecosystem = [
  { type: locale === "en" ? "Exchange" : locale === "ja" ? "取引所" : "交易所", name: "OKX", note: locale === "en" ? "Broad spot, fiat, and Web3 ecosystem" : locale === "ja" ? "現物・法定通貨・Web3 を幅広くカバー" : "现货、法币与 Web3 生态较完整" },
  { type: locale === "en" ? "Wallet" : locale === "ja" ? "ウォレット" : "钱包", name: "OKX Wallet", note: locale === "en" ? "Multi-chain, DApp, and swap tools" : locale === "ja" ? "マルチチェーン、DApp、Swap に対応" : "多链、DApp 与 Swap 体验完整" },
];

const scoreLabel = locale === "en" ? "Score" : locale === "ja" ? "評価" : "评分";
const featuredMeta = locale === "en" ? "Editor's pick · 8 min read" : locale === "ja" ? "編集部おすすめ · 8分" : "编辑推荐 · 8 分钟阅读";
const cardsIntro = locale === "en"
  ? "A short editor-curated list. Full fees and regional support live in Cards and Compare."
  : locale === "ja"
    ? "編集部が厳選した少数のカードのみ。詳細な手数料や地域対応は Cards / Compare で確認できます。"
    : "只展示少量值得进一步了解的卡片，完整费率与地区支持放到 Cards 和 Compare。";
const ecoIntro = locale === "en"
  ? "Supporting tools around the card ecosystem, not a logo directory."
  : locale === "ja"
    ? "カード利用を支える周辺サービスを厳選。ロゴ一覧にはしません。"
    : "作为 U 卡资金路径与支付生态的补充，只做精选，不做 Logo 导航。";
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout pb-14">
    <section class="border-border border-b py-10 sm:py-16">
      <div class="max-w-2xl">
        <p class="text-accent mb-3 text-[12px] font-semibold tracking-[0.04em]">{t.home.eyebrow}</p>

        <h1 class="editorial-serif home-title max-w-[650px] text-[1.95rem] leading-[1.24] font-medium tracking-[-0.03em] sm:text-[2.9rem]">
          {t.home.title}
        </h1>

        <p class="text-foreground/62 mt-5 max-w-xl text-[15px] leading-7 sm:text-[17px]">
          {t.home.intro}
        </p>

        <form action={localizedPath("/search", locale)} class="mt-7">
          <label for="home-search" class="sr-only">{t.search}</label>
          <div class="border-border bg-white/60 dark:bg-white/3 flex items-center border px-4 py-3.5">
            <input
              id="home-search"
              name="q"
              type="search"
              placeholder={t.home.searchPlaceholder}
              class="min-w-0 flex-1 bg-transparent text-[15px] outline-none placeholder:text-foreground/35"
            />
            <button class="text-accent ms-4 shrink-0 text-sm font-semibold" type="submit">{t.search}</button>
          </div>
        </form>
      </div>
    </section>

    <section class="border-border border-b py-11 sm:py-16">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-foreground/38 mb-1.5 text-[10px] tracking-[0.2em] uppercase">Featured</p>
          <h2 class="editorial-serif text-[1.65rem] leading-tight font-medium">{t.home.featured}</h2>
        </div>
      </div>

      <article>
        <a href={localizedPath("/posts", locale)} class="group block">
          <div class="feature-art border-border relative aspect-[16/9] overflow-hidden border bg-[#f2f4f5] dark:bg-[#1d2327]">
            <div class="feature-grid" aria-hidden="true"></div>
            <div class="feature-card feature-card-one" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="feature-card feature-card-two" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="feature-caption" aria-hidden="true">U CARD / 2026</div>
          </div>

          <div class="pt-5">
            <p class="text-foreground/42 mb-2 text-[11px]">{featuredMeta}</p>
            <h3 class="editorial-serif max-w-2xl text-[1.55rem] leading-[1.38] font-medium tracking-[-0.02em] group-hover:text-accent sm:text-[1.9rem]">
              {t.home.featuredTitle}
            </h3>
            <p class="text-foreground/58 mt-3 max-w-2xl text-[14px] leading-6 sm:text-[15px] sm:leading-7">
              {t.home.featuredDesc}
            </p>
          </div>
        </a>
      </article>
    </section>

    <section class="border-border border-b py-11 sm:py-16">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="text-foreground/38 mb-1.5 text-[10px] tracking-[0.2em] uppercase">Latest Updates</p>
          <h2 class="editorial-serif text-[1.65rem] leading-tight font-medium">{t.home.latest}</h2>
        </div>
        <a href={localizedPath("/posts", locale)} class="text-accent shrink-0 text-[13px] font-medium">{t.home.allNews}</a>
      </div>

      <div class="divide-border divide-y border-border border-t">
        {latest.map((item, index) => (
          <article class="grid grid-cols-[30px_1fr] gap-3 py-5.5">
            <span class="text-foreground/25 pt-0.5 text-[11px] tabular-nums">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <p class="text-foreground/42 mb-1.5 text-[11px]">{item.meta}</p>
              <h3 class="text-[1rem] leading-7 font-medium">{item.title}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="border-border border-b py-11 sm:py-16">
      <div class="mb-6">
        <p class="text-foreground/38 mb-1.5 text-[10px] tracking-[0.2em] uppercase">Recommended Cards</p>
        <h2 class="editorial-serif text-[1.65rem] leading-tight font-medium">{t.home.cards}</h2>
        <p class="text-foreground/52 mt-2 max-w-xl text-[13px] leading-6">{cardsIntro}</p>
      </div>

      <div class="divide-border divide-y border-border border-t">
        {cards.map((card, index) => (
          <article class="grid grid-cols-[28px_1fr_auto] items-start gap-3 py-5.5">
            <span class="text-foreground/25 pt-0.5 text-[11px]">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-[15px] font-semibold">{card.name}</h3>
              <p class="text-foreground/50 mt-1 text-[13px] leading-6">{card.note}</p>
            </div>
            <div class="min-w-[44px] text-right">
              <div class="text-[14px] font-semibold tabular-nums">{card.score}</div>
              <div class="text-foreground/34 mt-0.5 text-[10px]">{scoreLabel}</div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[13px] font-medium">
        <a href={localizedPath("/cards", locale)} class="text-accent">{t.home.allCards}</a>
        <a href={localizedPath("/compare", locale)} class="text-accent">{t.home.compare}</a>
      </div>
    </section>

    <section class="py-11 sm:py-16">
      <div class="mb-6">
        <p class="text-foreground/38 mb-1.5 text-[10px] tracking-[0.2em] uppercase">Ecosystem</p>
        <h2 class="editorial-serif text-[1.65rem] leading-tight font-medium">{t.home.ecosystem}</h2>
        <p class="text-foreground/52 mt-2 max-w-xl text-[13px] leading-6">{ecoIntro}</p>
      </div>

      <div class="divide-border divide-y border-border border-t">
        {ecosystem.map(item => (
          <article class="grid grid-cols-[68px_1fr] gap-4 py-5.5">
            <span class="text-foreground/38 pt-0.5 text-[11px]">{item.type}</span>
            <div>
              <h3 class="text-[15px] font-semibold">{item.name}</h3>
              <p class="text-foreground/50 mt-1 text-[13px] leading-6">{item.note}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-title {
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .feature-art {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.56), rgb(255 255 255 / 0.08)),
      #eef1f2;
  }

  :global(html[data-theme="dark"]) .feature-art {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.04), transparent),
      #1d2327;
  }

  .feature-grid {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    background-image:
      linear-gradient(to right, rgb(49 95 125 / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(49 95 125 / 0.08) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .feature-card {
    position: absolute;
    width: 48%;
    aspect-ratio: 1.58;
    border: 1px solid rgb(49 95 125 / 0.25);
    background: rgb(252 251 248 / 0.9);
    box-shadow: 0 12px 30px rgb(30 50 65 / 0.06);
    padding: 18px;
  }

  .feature-card span {
    display: block;
    height: 3px;
    margin-top: 9px;
    background: rgb(49 95 125 / 0.2);
  }

  .feature-card span:first-child {
    width: 24%;
    height: 6px;
    margin-top: 0;
    background: rgb(49 95 125 / 0.62);
  }

  .feature-card span:nth-child(2) {
    width: 72%;
  }

  .feature-card span:nth-child(3) {
    width: 46%;
  }

  .feature-card-one {
    top: 24%;
    left: 12%;
    transform: rotate(-5deg);
  }

  .feature-card-two {
    top: 34%;
    right: 9%;
    transform: rotate(6deg);
  }

  .feature-caption {
    position: absolute;
    right: 15px;
    bottom: 12px;
    color: rgb(49 95 125 / 0.48);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  @media (max-width: 639px) {
    .feature-card {
      padding: 14px;
    }
  }
</style>
