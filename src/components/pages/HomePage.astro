---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSiteCopy, normalizeLocale, localizedPath } from "@/i18n/site";

const locale = normalizeLocale(Astro.currentLocale);
const t = getSiteCopy(locale);

const copy = locale === "en" ? {
  heroKicker: "Independent crypto card research",
  heroTitle: "Find the crypto card that actually fits you.",
  heroBody: "Compare fees, availability, KYC, payment support and recent changes in one place.",
  search: "Search cards, fees, KYC, Apple Pay...",
  findCard: "Find a card",
  compare: "Compare cards",
  browseAll: "Browse all cards",
  overview: "Database overview",
  liveCards: "Live cards",
  trackedFields: "Tracked fields",
  verified: "Update status",
  topPicks: "Editor's picks",
  topPicksSub: "A short independent shortlist, not a paid ranking.",
  bestFor: "Best for",
  fee: "Top-up fee",
  kyc: "KYC",
  applePay: "Apple Pay",
  score: "Score",
  checked: "Last checked",
  quickCompare: "Quick compare",
  quickCompareSub: "See the most decision-critical differences first.",
  browseNeed: "Browse by need",
  browseRegion: "Browse by region",
  changes: "Latest changes",
  changesSub: "Fee, regional, KYC and payment-support updates.",
  guides: "Reviews & guides",
  ecosystem: "Payment ecosystem",
  viewAll: "View all",
  changeTypes: ["Region", "Payment", "Fees"],
} : locale === "ja" ? {
  heroKicker: "独立した暗号資産カード調査",
  heroTitle: "自分に本当に合う U カードを見つける。",
  heroBody: "手数料、地域、KYC、決済対応、最新の変更を一か所で比較できます。",
  search: "カード、手数料、KYC、Apple Pay を検索...",
  findCard: "カードを探す",
  compare: "カードを比較",
  browseAll: "すべてのカード",
  overview: "データベース概要",
  liveCards: "利用可能カード",
  trackedFields: "追跡項目",
  verified: "更新状況",
  topPicks: "編集部の厳選",
  topPicksSub: "広告順位ではなく、独立した少数の候補です。",
  bestFor: "おすすめ用途",
  fee: "入金手数料",
  kyc: "KYC",
  applePay: "Apple Pay",
  score: "評価",
  checked: "最終確認",
  quickCompare: "クイック比較",
  quickCompareSub: "判断に必要な違いだけを先に比較します。",
  browseNeed: "目的から探す",
  browseRegion: "地域から探す",
  changes: "最新の変更",
  changesSub: "手数料、地域、KYC、決済対応の更新を追跡します。",
  guides: "レビューとガイド",
  ecosystem: "決済エコシステム",
  viewAll: "すべて見る",
  changeTypes: ["地域", "決済", "手数料"],
} : {
  heroKicker: "独立 U 卡研究与比较",
  heroTitle: "找到真正适合你的 U 卡。",
  heroBody: "把费率、地区、KYC、支付支持和最新变化放在一起比较，少看推广，多看真正影响使用的差异。",
  search: "搜索 U 卡、费率、KYC、Apple Pay...",
  findCard: "找适合我的卡",
  compare: "开始对比",
  browseAll: "浏览全部卡片",
  overview: "数据库概览",
  liveCards: "可用卡片",
  trackedFields: "追踪字段",
  verified: "更新状态",
  topPicks: "编辑精选",
  topPicksSub: "独立筛选少量值得优先了解的卡片，不做付费排名。",
  bestFor: "适合",
  fee: "充值费",
  kyc: "KYC",
  applePay: "Apple Pay",
  score: "评分",
  checked: "最后核验",
  quickCompare: "快速对比",
  quickCompareSub: "先看真正影响选择的几个关键差异。",
  browseNeed: "按需求找卡",
  browseRegion: "按地区找卡",
  changes: "最新变化",
  changesSub: "持续追踪费率、地区、KYC 与支付支持变化。",
  guides: "评测与指南",
  ecosystem: "支付生态",
  viewAll: "查看全部",
  changeTypes: ["地区", "支付", "费率"],
};

const topPicks = [
  {
    name: "Bybit Card", score: "4.6",
    best: locale === "en" ? "Daily spending" : locale === "ja" ? "日常決済" : "日常消费",
    note: locale === "en" ? "Balanced for everyday use and mobile wallets." : locale === "ja" ? "日常利用とモバイルウォレットのバランスが良い。" : "日常消费与移动支付体验更均衡。",
    fee: "0–1%", kyc: locale === "en" ? "Required" : locale === "ja" ? "必要" : "需要", pay: "支持", checked: "2026-10-04"
  },
  {
    name: "OKX Card", score: "4.4",
    best: locale === "en" ? "Crypto-native users" : locale === "ja" ? "暗号資産ユーザー" : "加密资产用户",
    note: locale === "en" ? "Strong fit for users already inside the OKX ecosystem." : locale === "ja" ? "OKX エコシステム利用者との相性が良い。" : "更适合已经在 OKX 生态内的用户。",
    fee: "浮动", kyc: locale === "en" ? "Required" : locale === "ja" ? "必要" : "需要", pay: "支持", checked: "2026-10-03"
  },
  {
    name: "RedotPay", score: "4.3",
    best: locale === "en" ? "USDT spending" : locale === "ja" ? "USDT 決済" : "USDT 支付",
    note: locale === "en" ? "Simple path from stablecoins to card spending." : locale === "ja" ? "ステーブルコインからカード決済までが分かりやすい。" : "从稳定币到卡片消费的路径更直接。",
    fee: "1%", kyc: locale === "en" ? "Required" : locale === "ja" ? "必要" : "需要", pay: "—", checked: "2026-10-02"
  },
];

const needs = locale === "en"
  ? ["Low fees", "Apple Pay", "USDT", "Virtual card", "No staking", "Travel"]
  : locale === "ja"
    ? ["低手数料", "Apple Pay", "USDT", "バーチャルカード", "ステーキング不要", "旅行"]
    : ["低费率", "Apple Pay", "USDT", "虚拟卡", "无需质押", "旅行消费"];

const regions = locale === "en"
  ? ["Mainland China", "Hong Kong", "Japan", "Singapore", "Europe", "Global"]
  : locale === "ja"
    ? ["中国本土", "香港", "日本", "シンガポール", "ヨーロッパ", "グローバル"]
    : ["中国大陆", "香港", "日本", "新加坡", "欧洲", "全球可用"];

const changes = [
  {
    date: locale === "en" ? "Oct 5" : locale === "ja" ? "10/5" : "10 月 5 日",
    name: "Bybit Card", type: copy.changeTypes[0],
    change: locale === "en" ? "Regional availability documentation updated" : locale === "ja" ? "地域対応ドキュメントを更新" : "地区可用性说明更新"
  },
  {
    date: locale === "en" ? "Oct 4" : locale === "ja" ? "10/4" : "10 月 4 日",
    name: "OKX Card", type: copy.changeTypes[1],
    change: locale === "en" ? "Apple Pay support status re-verified" : locale === "ja" ? "Apple Pay 対応を再確認" : "Apple Pay 支持状态重新核验"
  },
  {
    date: locale === "en" ? "Oct 3" : locale === "ja" ? "10/3" : "10 月 3 日",
    name: "RedotPay", type: copy.changeTypes[2],
    change: locale === "en" ? "Top-up fee data refreshed" : locale === "ja" ? "入金手数料データを更新" : "充值费数据已更新"
  },
];

const guides = locale === "en"
  ? [
      { title: "How to choose a crypto card in 2026", meta: "Guide · 8 min" },
      { title: "What stricter KYC means for long-term card use", meta: "Risk · 6 min" },
    ]
  : locale === "ja"
    ? [
        { title: "2026 年の暗号資産カードの選び方", meta: "ガイド · 8分" },
        { title: "KYC 強化が長期利用に与える影響", meta: "リスク · 6分" },
      ]
    : [
        { title: "2026 年，应该怎么选一张长期能用的 U 卡？", meta: "指南 · 8 分钟" },
        { title: "KYC 趋严后，哪些变化最值得注意？", meta: "风险 · 6 分钟" },
      ];

const ecosystem = [
  { name: "OKX", type: locale === "en" ? "Exchange" : locale === "ja" ? "取引所" : "交易所" },
  { name: "OKX Wallet", type: locale === "en" ? "Wallet" : locale === "ja" ? "ウォレット" : "钱包" },
  { name: "Rabby", type: locale === "en" ? "Wallet" : locale === "ja" ? "ウォレット" : "钱包" },
];
---

<Layout>
  <Header />

  <main id="main-content">
    <section class="home-shell border-border border-b py-10 sm:py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[1.3fr_.7fr] lg:items-end lg:gap-16">
        <div>
          <p class="section-kicker">{copy.heroKicker}</p>
          <h1 class="home-title max-w-[720px] text-[2.15rem] leading-[1.16] font-semibold tracking-[-0.04em] sm:text-[3.2rem] lg:text-[3.65rem]">
            {copy.heroTitle}
          </h1>
          <p class="text-foreground/62 mt-5 max-w-[640px] text-[15px] leading-7 sm:text-[17px]">{copy.heroBody}</p>

          <form action={localizedPath("/search", locale)} class="mt-7 max-w-[680px]">
            <label for="home-search" class="sr-only">{t.search}</label>
            <div class="border-border bg-white/75 dark:bg-white/3 flex items-center border px-4 py-3.5">
              <input id="home-search" name="q" type="search" placeholder={copy.search}
                class="min-w-0 flex-1 bg-transparent text-[15px] outline-none placeholder:text-foreground/35" />
              <button class="text-accent ms-4 shrink-0 text-sm font-semibold" type="submit">{t.search}</button>
            </div>
          </form>

          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-[13px] font-semibold">
            <a href={localizedPath("/cards", locale)} class="text-accent">{copy.findCard} →</a>
            <a href={localizedPath("/compare", locale)} class="text-foreground/62 hover:text-accent">{copy.compare}</a>
            <a href={localizedPath("/cards", locale)} class="text-foreground/62 hover:text-accent">{copy.browseAll}</a>
          </div>
        </div>

        <aside class="border-border bg-muted/45 border p-5 sm:p-6">
          <p class="text-foreground/42 text-[11px] font-medium">{copy.overview}</p>
          <div class="mt-5 grid grid-cols-3 gap-4">
            <div>
              <div class="text-[1.55rem] font-semibold tabular-nums">3</div>
              <p class="text-foreground/44 mt-1 text-[11px] leading-5">{copy.liveCards}</p>
            </div>
            <div>
              <div class="text-[1.55rem] font-semibold tabular-nums">25</div>
              <p class="text-foreground/44 mt-1 text-[11px] leading-5">{copy.trackedFields}</p>
            </div>
            <div>
              <div class="text-[1.25rem] font-semibold">持续更新</div>
              <p class="text-foreground/44 mt-1 text-[11px] leading-5">{copy.verified}</p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="home-shell border-border border-b py-11 sm:py-16">
      <div class="mb-7 flex items-end justify-between gap-5">
        <div>
          <h2 class="section-title">{copy.topPicks}</h2>
          <p class="section-desc">{copy.topPicksSub}</p>
        </div>
        <a href={localizedPath("/cards", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.viewAll}</a>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {topPicks.map(card => (
          <article class="border-border bg-white/55 dark:bg-white/2 flex min-h-[220px] flex-col border p-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-[17px] font-semibold">{card.name}</h3>
              <div class="text-right">
                <div class="text-[16px] font-semibold tabular-nums">{card.score}</div>
                <div class="text-foreground/34 mt-0.5 text-[10px]">{copy.score}</div>
              </div>
            </div>
            <p class="text-accent mt-4 text-[12px] font-medium">{copy.bestFor}：{card.best}</p>
            <p class="text-foreground/56 mt-2 text-[13px] leading-6">{card.note}</p>
            <dl class="border-border mt-5 grid grid-cols-3 gap-3 border-t pt-4 text-[11px]">
              <div><dt class="text-foreground/38">{copy.fee}</dt><dd class="mt-1 font-medium">{card.fee}</dd></div>
              <div><dt class="text-foreground/38">{copy.kyc}</dt><dd class="mt-1 font-medium">{card.kyc}</dd></div>
              <div><dt class="text-foreground/38">{copy.applePay}</dt><dd class="mt-1 font-medium">{card.pay}</dd></div>
            </dl>
            <p class="text-foreground/30 mt-auto pt-4 text-[10px]">{copy.checked}：{card.checked}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-shell border-border border-b py-11 sm:py-16">
      <div class="mb-7 flex items-end justify-between gap-5">
        <div>
          <h2 class="section-title">{copy.quickCompare}</h2>
          <p class="section-desc">{copy.quickCompareSub}</p>
        </div>
        <a href={localizedPath("/compare", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.compare}</a>
      </div>

      <div class="border-border overflow-x-auto border">
        <table class="min-w-[720px] w-full border-collapse text-left text-[12px]">
          <thead class="bg-muted/55">
            <tr class="border-border border-b">
              <th class="px-5 py-4 font-medium"></th>
              {topPicks.map(card => <th class="px-5 py-4 text-[13px] font-semibold">{card.name}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr class="border-border border-b">
              <td class="text-foreground/45 px-5 py-4">{copy.fee}</td>
              {topPicks.map(card => <td class="px-5 py-4">{card.fee}</td>)}
            </tr>
            <tr class="border-border border-b">
              <td class="text-foreground/45 px-5 py-4">{copy.kyc}</td>
              {topPicks.map(card => <td class="px-5 py-4">{card.kyc}</td>)}
            </tr>
            <tr class="border-border border-b">
              <td class="text-foreground/45 px-5 py-4">{copy.applePay}</td>
              {topPicks.map(card => <td class="px-5 py-4">{card.pay}</td>)}
            </tr>
            <tr>
              <td class="text-foreground/45 px-5 py-4">{copy.score}</td>
              {topPicks.map(card => <td class="px-5 py-4 font-semibold">{card.score}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="home-shell border-border grid gap-12 border-b py-11 sm:py-16 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="section-title">{copy.browseNeed}</h2>
        <div class="border-border mt-5 border-t">
          {needs.map(item => (
            <a href={localizedPath("/cards", locale) + "?need=" + encodeURIComponent(item)}
              class="border-border hover:text-accent flex items-center justify-between border-b py-4 text-[14px]">
              <span>{item}</span><span class="text-foreground/30">→</span>
            </a>
          ))}
        </div>
      </div>
      <div>
        <h2 class="section-title">{copy.browseRegion}</h2>
        <div class="border-border mt-5 border-t">
          {regions.map(item => (
            <a href={localizedPath("/cards", locale) + "?region=" + encodeURIComponent(item)}
              class="border-border hover:text-accent flex items-center justify-between border-b py-4 text-[14px]">
              <span>{item}</span><span class="text-foreground/30">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-shell border-border border-b py-11 sm:py-16">
      <div class="mb-7 flex items-end justify-between gap-5">
        <div>
          <h2 class="section-title">{copy.changes}</h2>
          <p class="section-desc">{copy.changesSub}</p>
        </div>
        <a href={localizedPath("/posts", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.viewAll}</a>
      </div>

      <div class="grid gap-0 lg:grid-cols-3">
        {changes.map((item, index) => (
          <article class:list={[
            "border-border py-5 lg:px-6 lg:py-1",
            index < changes.length - 1 && "border-b lg:border-b-0 lg:border-r",
            index === 0 && "lg:pl-0",
            index === changes.length - 1 && "lg:pr-0",
          ]}>
            <div class="flex items-center gap-3">
              <span class="text-foreground/36 text-[10px]">{item.date}</span>
              <span class="text-accent text-[10px] font-medium">{item.type}</span>
            </div>
            <h3 class="mt-3 text-[15px] font-semibold">{item.name}</h3>
            <p class="text-foreground/55 mt-1 text-[13px] leading-6">{item.change}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-shell border-border border-b py-11 sm:py-16">
      <div class="mb-7 flex items-end justify-between gap-5">
        <h2 class="section-title">{copy.guides}</h2>
        <a href={localizedPath("/posts", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.viewAll}</a>
      </div>
      <div class="grid gap-8 lg:grid-cols-[1.25fr_.75fr] lg:gap-16">
        {guides.map((item, index) => (
          <article class:list={[index === 1 && "border-border lg:border-l lg:pl-8"]}>
            <p class="text-foreground/38 mb-2 text-[10px]">{item.meta}</p>
            <h3 class="text-[1.45rem] leading-[1.35] font-semibold tracking-[-0.025em] sm:text-[1.7rem]">{item.title}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="home-shell py-11 sm:py-16">
      <h2 class="section-title">{copy.ecosystem}</h2>
      <div class="border-border mt-5 border-t">
        {ecosystem.map(item => (
          <article class="border-border grid grid-cols-[84px_1fr_auto] items-center gap-4 border-b py-4">
            <span class="text-foreground/38 text-[11px]">{item.type}</span>
            <h3 class="text-[14px] font-semibold">{item.name}</h3>
            <span class="text-foreground/25 text-[12px]">→</span>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-shell {
    width: calc(100% - 2rem);
    max-width: 72rem;
    margin-inline: auto;
  }
  .home-title {
    overflow-wrap: anywhere;
    font-family: var(--font-editorial-sans);
  }
  .section-kicker {
    margin-bottom: 0.65rem;
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .section-title {
    font-family: var(--font-editorial-sans);
    font-size: 1.7rem;
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .section-desc {
    margin-top: 0.5rem;
    max-width: 40rem;
    color: color-mix(in srgb, var(--foreground) 52%, transparent);
    font-size: 13px;
    line-height: 1.7;
  }
</style>
