---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSiteCopy, normalizeLocale, localizedPath } from "@/i18n/site";

const locale = normalizeLocale(Astro.currentLocale);
const t = getSiteCopy(locale);

const copy = locale === "en" ? {
  heroKicker: "Independent crypto card research",
  heroTitle: "Find the crypto card that actually fits you.",
  heroBody: "Compare fees, availability, KYC, Apple Pay, Google Pay and real-world changes — without digging through scattered product pages.",
  findCard: "Find a card",
  compare: "Compare cards",
  database: "Browse database",
  topPicks: "Top picks",
  topPicksSub: "A short editorial shortlist — not a paid ranking.",
  quickCompare: "Quick compare",
  browseNeed: "Browse by need",
  browseRegion: "Browse by region",
  changes: "Latest changes",
  changesSub: "Policy, fee and availability updates that can change your decision.",
  guides: "Reviews & guides",
  ecosystem: "Payment ecosystem",
  viewAll: "View all",
  checked: "Last checked",
  bestFor: "Best for",
  fee: "Top-up fee",
  kyc: "KYC",
  applePay: "Apple Pay",
  score: "Score",
  updated: "Updated",
} : locale === "ja" ? {
  heroKicker: "独立した暗号資産カード調査",
  heroTitle: "自分に本当に合う U カードを見つける。",
  heroBody: "手数料、地域対応、KYC、Apple Pay、Google Pay、最新変更を一か所で比較できます。",
  findCard: "カードを探す",
  compare: "カードを比較",
  database: "データベースを見る",
  topPicks: "編集部の厳選",
  topPicksSub: "広告順位ではなく、少数の候補に絞ります。",
  quickCompare: "クイック比較",
  browseNeed: "目的から探す",
  browseRegion: "地域から探す",
  changes: "最新の変更",
  changesSub: "手数料・地域・KYC・決済対応の変更を追跡。",
  guides: "レビューとガイド",
  ecosystem: "決済エコシステム",
  viewAll: "すべて見る",
  checked: "最終確認",
  bestFor: "おすすめ用途",
  fee: "入金手数料",
  kyc: "KYC",
  applePay: "Apple Pay",
  score: "評価",
  updated: "更新",
} : {
  heroKicker: "独立 U 卡研究与比较",
  heroTitle: "找到真正适合你的 U 卡。",
  heroBody: "把费率、地区、KYC、Apple Pay、Google Pay 和最新变化放到一起比较，不用再翻几十个官网和推广页面。",
  findCard: "找适合我的卡",
  compare: "开始对比",
  database: "浏览全部卡片",
  topPicks: "编辑精选",
  topPicksSub: "只给少量结论，不做付费排名。",
  quickCompare: "快速对比",
  browseNeed: "按需求找卡",
  browseRegion: "按地区找卡",
  changes: "最新变化",
  changesSub: "真正会影响你决策的费率、地区、KYC 与支付支持变化。",
  guides: "评测与指南",
  ecosystem: "支付生态",
  viewAll: "查看全部",
  checked: "最后核验",
  bestFor: "适合",
  fee: "充值费",
  kyc: "KYC",
  applePay: "Apple Pay",
  score: "评分",
  updated: "更新",
};

const topPicks = [
  { name: "Bybit Card", score: "4.6", best: locale === "en" ? "Daily spending" : locale === "ja" ? "日常決済" : "日常消费", fee: "0–1%", kyc: locale === "en" ? "Required" : locale === "ja" ? "必要" : "需要", pay: "✓", checked: "2026-10-04" },
  { name: "OKX Card", score: "4.4", best: locale === "en" ? "Crypto-native users" : locale === "ja" ? "暗号資産ユーザー" : "加密资产用户", fee: "Varies", kyc: locale === "en" ? "Required" : locale === "ja" ? "必要" : "需要", pay: "✓", checked: "2026-10-03" },
  { name: "RedotPay", score: "4.3", best: locale === "en" ? "USDT spending" : locale === "ja" ? "USDT 決済" : "USDT 支付", fee: "1%", kyc: locale === "en" ? "Required" : locale === "ja" ? "必要" : "需要", pay: "—", checked: "2026-10-02" },
];

const needs = locale === "en"
  ? ["Low fees", "Apple Pay", "USDT", "Virtual card", "No staking", "Travel"]
  : locale === "ja"
    ? ["低手数料", "Apple Pay", "USDT", "バーチャルカード", "ステーキング不要", "旅行"]
    : ["低费率", "Apple Pay", "USDT", "虚拟卡", "无需质押", "旅行消费"];

const regions = locale === "en"
  ? ["Mainland China", "Hong Kong", "Japan", "Singapore", "Europe", "Global"]
  : locale === "ja"
    ? ["中国本土", "香港", "日本", "シンガポール", "ヨーロッパ", "グローバル"]
    : ["中国大陆", "香港", "日本", "新加坡", "欧洲", "全球可用"];

const changes = locale === "en"
  ? [
      { date: "Oct 5", name: "Bybit Card", change: "Regional availability documentation updated", type: "Region" },
      { date: "Oct 4", name: "OKX Card", change: "Apple Pay support note re-verified", type: "Payment" },
      { date: "Oct 3", name: "RedotPay", change: "Top-up fee data refreshed", type: "Fees" },
    ]
  : locale === "ja"
    ? [
        { date: "10/5", name: "Bybit Card", change: "地域対応ドキュメントを更新", type: "地域" },
        { date: "10/4", name: "OKX Card", change: "Apple Pay 対応を再確認", type: "決済" },
        { date: "10/3", name: "RedotPay", change: "入金手数料データを更新", type: "手数料" },
      ]
    : [
        { date: "10 月 5 日", name: "Bybit Card", change: "地区可用性说明更新", type: "地区" },
        { date: "10 月 4 日", name: "OKX Card", change: "Apple Pay 支持状态重新核验", type: "支付" },
        { date: "10 月 3 日", name: "RedotPay", change: "充值费数据已更新", type: "费率" },
      ];

const guides = locale === "en"
  ? [
      { title: "How to choose a crypto card in 2026", meta: "Guide · 8 min" },
      { title: "What KYC changes mean for long-term card use", meta: "Risk · 6 min" },
    ]
  : locale === "ja"
    ? [
        { title: "2026 年の暗号資産カードの選び方", meta: "ガイド · 8分" },
        { title: "KYC 強化が長期利用に与える影響", meta: "リスク · 6分" },
      ]
    : [
        { title: "2026 年，应该怎么选一张长期能用的 U 卡？", meta: "指南 · 8 分钟" },
        { title: "KYC 趋严后，哪些变化最值得注意？", meta: "风险 · 6 分钟" },
      ];

const ecosystem = [
  { name: "OKX", type: locale === "en" ? "Exchange" : locale === "ja" ? "取引所" : "交易所" },
  { name: "OKX Wallet", type: locale === "en" ? "Wallet" : locale === "ja" ? "ウォレット" : "钱包" },
  { name: "Rabby", type: locale === "en" ? "Wallet" : locale === "ja" ? "ウォレット" : "钱包" },
];
---

<Layout>
  <Header />

  <main id="main-content">
    <section class="app-layout border-border border-b py-10 sm:py-16">
      <div class="max-w-2xl">
        <p class="text-accent mb-3 text-[11px] font-semibold tracking-[0.08em] uppercase">{copy.heroKicker}</p>
        <h1 class="editorial-serif home-title max-w-[640px] text-[2.05rem] leading-[1.2] font-medium tracking-[-0.035em] sm:text-[3rem]">
          {copy.heroTitle}
        </h1>
        <p class="text-foreground/62 mt-5 max-w-xl text-[15px] leading-7 sm:text-[17px]">{copy.heroBody}</p>

        <form action={localizedPath("/search", locale)} class="mt-7">
          <label for="home-search" class="sr-only">{t.search}</label>
          <div class="border-border bg-white/70 dark:bg-white/3 flex items-center border px-4 py-3.5">
            <input id="home-search" name="q" type="search" placeholder={t.home.searchPlaceholder}
              class="min-w-0 flex-1 bg-transparent text-[15px] outline-none placeholder:text-foreground/35" />
            <button class="text-accent ms-4 shrink-0 text-sm font-semibold" type="submit">{t.search}</button>
          </div>
        </form>

        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3 text-[13px] font-semibold">
          <a href={localizedPath("/cards", locale)} class="text-accent">{copy.findCard} →</a>
          <a href={localizedPath("/compare", locale)} class="text-foreground/62 hover:text-accent">{copy.compare}</a>
          <a href={localizedPath("/cards", locale)} class="text-foreground/62 hover:text-accent">{copy.database}</a>
        </div>
      </div>
    </section>

    <section class="app-layout border-border border-b py-11 sm:py-16">
      <div class="mb-6">
        <p class="section-kicker">Top Picks</p>
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="section-title">{copy.topPicks}</h2>
            <p class="section-desc">{copy.topPicksSub}</p>
          </div>
          <a href={localizedPath("/cards", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.viewAll}</a>
        </div>
      </div>

      <div class="divide-border divide-y border-border border-t">
        {topPicks.map(card => (
          <article class="grid grid-cols-[1fr_auto] gap-4 py-5.5">
            <div>
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <h3 class="text-[15px] font-semibold">{card.name}</h3>
                <span class="text-foreground/38 text-[11px]">{copy.bestFor}: {card.best}</span>
              </div>
              <div class="text-foreground/45 mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px]">
                <span>{copy.fee}: {card.fee}</span>
                <span>{copy.kyc}: {card.kyc}</span>
                <span>{copy.applePay}: {card.pay}</span>
              </div>
              <p class="text-foreground/32 mt-2 text-[10px]">{copy.checked}: {card.checked}</p>
            </div>
            <div class="text-right">
              <div class="text-[15px] font-semibold tabular-nums">{card.score}</div>
              <div class="text-foreground/35 mt-0.5 text-[10px]">{copy.score}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="app-layout border-border border-b py-11 sm:py-16">
      <p class="section-kicker">Compare</p>
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="section-title">{copy.quickCompare}</h2>
        <a href={localizedPath("/compare", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.compare}</a>
      </div>

      <div class="compare-shell border-border overflow-x-auto border">
        <table class="min-w-[620px] w-full border-collapse text-left text-[12px]">
          <thead class="bg-muted/55">
            <tr class="border-border border-b">
              <th class="px-4 py-3 font-medium"></th>
              {topPicks.map(card => <th class="px-4 py-3 text-[13px] font-semibold">{card.name}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr class="border-border border-b">
              <td class="text-foreground/45 px-4 py-3">{copy.fee}</td>
              {topPicks.map(card => <td class="px-4 py-3">{card.fee}</td>)}
            </tr>
            <tr class="border-border border-b">
              <td class="text-foreground/45 px-4 py-3">{copy.kyc}</td>
              {topPicks.map(card => <td class="px-4 py-3">{card.kyc}</td>)}
            </tr>
            <tr class="border-border border-b">
              <td class="text-foreground/45 px-4 py-3">{copy.applePay}</td>
              {topPicks.map(card => <td class="px-4 py-3">{card.pay}</td>)}
            </tr>
            <tr>
              <td class="text-foreground/45 px-4 py-3">{copy.score}</td>
              {topPicks.map(card => <td class="px-4 py-3 font-semibold">{card.score}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="app-layout border-border grid gap-10 border-b py-11 sm:grid-cols-2 sm:gap-12 sm:py-16">
      <div>
        <p class="section-kicker">Browse by Need</p>
        <h2 class="section-title">{copy.browseNeed}</h2>
        <div class="border-border mt-5 border-t">
          {needs.map(item => (
            <a href={localizedPath("/cards", locale) + "?need=" + encodeURIComponent(item)}
              class="border-border hover:text-accent flex items-center justify-between border-b py-3.5 text-[14px]">
              <span>{item}</span><span class="text-foreground/30">→</span>
            </a>
          ))}
        </div>
      </div>
      <div>
        <p class="section-kicker">Browse by Region</p>
        <h2 class="section-title">{copy.browseRegion}</h2>
        <div class="border-border mt-5 border-t">
          {regions.map(item => (
            <a href={localizedPath("/cards", locale) + "?region=" + encodeURIComponent(item)}
              class="border-border hover:text-accent flex items-center justify-between border-b py-3.5 text-[14px]">
              <span>{item}</span><span class="text-foreground/30">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="app-layout border-border border-b py-11 sm:py-16">
      <div class="mb-6">
        <p class="section-kicker">Change Log</p>
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="section-title">{copy.changes}</h2>
            <p class="section-desc">{copy.changesSub}</p>
          </div>
          <a href={localizedPath("/posts", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.viewAll}</a>
        </div>
      </div>

      <div class="divide-border divide-y border-border border-t">
        {changes.map(item => (
          <article class="grid grid-cols-[74px_1fr] gap-3 py-5">
            <div>
              <p class="text-foreground/36 text-[10px]">{item.date}</p>
              <p class="text-accent mt-1 text-[10px]">{item.type}</p>
            </div>
            <div>
              <h3 class="text-[14px] font-semibold">{item.name}</h3>
              <p class="text-foreground/55 mt-1 text-[13px] leading-6">{item.change}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="app-layout border-border border-b py-11 sm:py-16">
      <p class="section-kicker">Editorial</p>
      <div class="mb-6 flex items-end justify-between gap-4">
        <h2 class="section-title">{copy.guides}</h2>
        <a href={localizedPath("/posts", locale)} class="text-accent shrink-0 text-[12px] font-medium">{copy.viewAll}</a>
      </div>

      <div class="grid gap-7 sm:grid-cols-2">
        {guides.map((item, index) => (
          <article class:list={["border-border", index === 0 ? "sm:border-r sm:pr-7" : ""]}>
            <p class="text-foreground/38 mb-2 text-[10px]">{item.meta}</p>
            <h3 class="editorial-serif text-[1.35rem] leading-[1.38] font-medium tracking-[-0.02em]">{item.title}</h3>
          </article>
        ))}
      </div>
    </section>

    <section class="app-layout py-11 sm:py-16">
      <p class="section-kicker">Ecosystem</p>
      <h2 class="section-title">{copy.ecosystem}</h2>
      <div class="border-border mt-5 border-t">
        {ecosystem.map(item => (
          <article class="border-border grid grid-cols-[80px_1fr_auto] items-center gap-3 border-b py-4">
            <span class="text-foreground/38 text-[11px]">{item.type}</span>
            <h3 class="text-[14px] font-semibold">{item.name}</h3>
            <span class="text-foreground/25 text-[12px]">→</span>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-title { overflow-wrap: anywhere; }
  .section-kicker {
    margin-bottom: 0.35rem;
    color: color-mix(in srgb, var(--foreground) 38%, transparent);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .section-title {
    font-family: var(--font-editorial-serif);
    font-size: 1.65rem;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .section-desc {
    margin-top: 0.45rem;
    max-width: 36rem;
    color: color-mix(in srgb, var(--foreground) 52%, transparent);
    font-size: 13px;
    line-height: 1.7;
  }
  .compare-shell { scrollbar-width: thin; }
</style>
